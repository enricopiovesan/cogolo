              "cancelled"
            ],
            "done": [],
            "cancelled": []
          },
          "owner_only": true
        }
      },
      "output_example": {
        "allowed": false,
        "new_status": "done",
        "reason_code": "illegal_transition",
        "evaluation_trace": [
          "done has no allowed transition to open"
        ]
      },
      "happy": false,
      "persona_ref": "runtime-engineer"
    },
