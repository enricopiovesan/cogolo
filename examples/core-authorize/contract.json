          {
            "rule_id": "admin-delete",
            "effect": "allow",
            "priority": 100
          }
        ],
        "obligations": [],
        "evaluation_trace": [
          "policy_version=1.0 mode=hybrid default=deny",
          "evaluated 1 rule(s)",
          "rule admin-delete matched on role+action+resource.type \u2192 allow"
