            "break_glass": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "required_attribute": {
                  "type": "string"
                },
                "max_priority": {
                  "type": "integer"
                }
              }
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "effect",
                  "priority"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "effect": {
                    "type": "string",
                    "enum": [
                      "allow",
