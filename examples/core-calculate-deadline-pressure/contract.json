{
  "kind": "capability_contract",
  "schema_version": "1.0.0",
  "id": "core.calculate-deadline-pressure",
  "namespace": "core",
  "name": "calculate-deadline-pressure",
  "version": "1.1.0",
  "lifecycle": "active",
  "owner": {
    "team": "loop",
    "contact": "founders@loop.dev"
  },
  "summary": "Computes a deterministic deadline pressure score from due date versus a reference date.",
  "description": "Pure WF2 capability used after ownership assignment. Maps days-until-due into a 0.0-1.0 pressure_score and a band (low|medium|high|overdue).\n\nImplemented and smoke-tested matrix (use_cases):\n- due-soon medium pressure\n- overdue max pressure\n- missing_due_date when due_date is empty\n- invalid_date for unparseable dates\n- config_error when reference_date is empty\n\nKnown limitations (intentional in 1.1.0):\n- Band thresholds are fixed heuristic cutovers; no calendar/holiday awareness",
  "use_cases": [
    {
      "scenario": "As a commit pipeline, I want pressure for an item due in three days, so that due-soon work surfaces at the right urgency band.",
      "input_example": {
        "item": {
          "id": "ai-1",
          "due_date": "2026-08-10",
          "status": "open"
        },
        "reference_date": "2026-08-07",
        "pressure_config": {
          "version": "1.0",
          "horizon_days": 14
        }
      },
      "output_example": {
        "item_id": "ai-1",
        "pressure_score": 0.786,
        "days_until_due": 3,
        "pressure_band": "medium",
        "reason_code": "ok",
        "evaluation_trace": [
          "days_until_due=3",
          "horizon=14",
          "band=medium"
        ]
      },
      "happy": true,
      "persona_ref": "runtime-engineer"
    },
    {
      "scenario": "As a system, I want overdue items to receive maximum pressure, so that late work is ranked above merely approaching deadlines.",
      "input_example": {
        "item": {
          "id": "ai-2",
          "due_date": "2026-08-01",
          "status": "open"
        },
        "reference_date": "2026-08-07",
        "pressure_config": {
          "version": "1.0",
          "horizon_days": 14
        }
      },
      "output_example": {
        "item_id": "ai-2",
        "pressure_score": 1.0,
        "days_until_due": -6,
        "pressure_band": "overdue",
        "reason_code": "ok",
        "evaluation_trace": [
          "days_until_due=-6",
          "horizon=14",
          "band=overdue"
        ]
      },
      "happy": true,
      "persona_ref": "collaboration-product-owner"
    },
    {
      "scenario": "As a WF2 workflow author, I want missing_due_date when due_date is empty, so that undated items fail closed.",
      "input_example": {
        "item": {
          "id": "ai-m",
          "due_date": "",
          "status": "open"
        },
        "reference_date": "2026-08-07",
        "pressure_config": {
          "version": "1.0",
          "horizon_days": 14
        }
      },
      "output_example": {
        "item_id": "ai-m",
        "pressure_score": 0,
        "days_until_due": 0,
        "pressure_band": "unknown",
        "reason_code": "missing_due_date",
        "evaluation_trace": []
      },
      "happy": false,
      "persona_ref": "runtime-engineer"
    },
    {
      "scenario": "As a WF2 workflow author, I want invalid_date when due_date cannot be parsed, so that bad date strings never invent pressure.",
      "input_example": {
        "item": {
          "id": "ai-i",
          "due_date": "not-a-date",
          "status": "open"
        },
        "reference_date": "2026-08-07",
        "pressure_config": {
          "version": "1.0",
          "horizon_days": 14
        }
      },
      "output_example": {
        "item_id": "ai-i",
        "pressure_score": 0,
        "days_until_due": 0,
        "pressure_band": "unknown",
        "reason_code": "invalid_date",
        "evaluation_trace": []
      },
      "happy": false,
      "persona_ref": "runtime-engineer"
    },
    {
      "scenario": "As a WF2 workflow author, I want config_error when reference_date is empty, so that pressure is never computed without an anchor.",
      "input_example": {
        "item": {
          "id": "ai-c",
          "due_date": "2026-08-10",
          "status": "open"
        },
        "reference_date": "",
        "pressure_config": {
          "version": "1.0",
          "horizon_days": 14
        }
      },
      "output_example": {
        "item_id": "",
        "pressure_score": 0,
        "days_until_due": 0,
        "pressure_band": "unknown",
        "reason_code": "config_error",
        "evaluation_trace": []
      },
      "happy": false,
      "persona_ref": "runtime-engineer"
    }
  ],
  "inputs": {
    "schema": {
      "type": "object",
      "required": [
        "item",
        "reference_date",
        "pressure_config"
      ],
      "properties": {
        "item": {
          "type": "object",
          "required": [
            "id",
            "due_date"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "due_date": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          }
        },
        "reference_date": {
          "type": "string"
        },
        "pressure_config": {
          "type": "object",
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "type": "string"
            },
            "horizon_days": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  },
  "outputs": {
    "schema": {
      "type": "object",
      "required": [
        "pressure_score",
        "pressure_band",
        "reason_code"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "pressure_score": {
          "type": "number"
        },
        "days_until_due": {
          "type": "integer"
        },
        "pressure_band": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "overdue",
            "unknown"
          ]
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "ok",
            "missing_due_date",
            "invalid_date",
            "config_error"
          ]
        },
        "evaluation_trace": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "preconditions": [],
  "postconditions": [
