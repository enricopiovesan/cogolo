{
  "kind": "connector_contract",
  "schema_version": "1.0.0",
  "connector_id": "traverse.object-store",
  "version": "1.0.0",
  "capabilities_provided": [
    "traverse.object_store.put"
  ],
  "required_config_schema": {
    "type": "object",
    "required": [
      "authority_ref"
    ],
    "properties": {
      "authority_ref": {
        "type": "string"
      },
      "retention_classes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  },
  "operation_envelopes": [
    {
      "operation_id": "put_immutable",
      "request_schema": {
        "type": "object",
        "required": [
