          "media_type",
          "idempotency_key"
        ],
        "properties": {
          "content_ref": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "retention_class": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "success_schema": {
        "type": "object",
        "required": [
          "asset_ref",
          "content_digest",
          "size",
          "result_class"
        ],
        "properties": {
          "asset_ref": {
            "type": "string"
          },
          "content_digest": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "result_class": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "failure_classes": [
        "configuration",
        "authorization",
        "quota",
        "integrity"
      ]
    }
  ],
  "supported_placement_targets": [
    "local",
    "cloud"
  ]
